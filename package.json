{
  "name": "dream-unity-theory-atlas",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "tsc -b && vite build && node scripts/finalize-build.mjs",
    "pages:prepare": "npm run build && node scripts/sync-pages-root.mjs",
    "seed:export": "node --experimental-strip-types scripts/export-seed.mjs",
