    "test": "vitest run src/lib/document.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.5",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.542.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.0"
  }
}
